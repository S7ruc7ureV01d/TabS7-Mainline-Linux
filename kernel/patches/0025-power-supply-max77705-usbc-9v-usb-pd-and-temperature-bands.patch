+/* OPCODE_CURRENT_SRCCAP reply: [1] = selected position << 3 | count */
+#define MAX77705_SRCCAP_SEL		GENMASK(5, 3)
+#define MAX77705_SRCCAP_NUM		GENMASK(2, 0)
+/* USB-PD fixed supply PDO */
+#define PDO_TYPE			GENMASK(31, 30)
+#define PDO_TYPE_FIXED			0
+#define PDO_FIXED_VOLT			GENMASK(19, 10)	/* 50 mV units */

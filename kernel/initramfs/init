#!/bin/busybox sh
# Phase 5 real init handoff for gts7l - finds the Arch Linux ARM root
# filesystem (LABEL=archroot, the Android userdata partition reused per
# docs/phase5-userspace-scoping.md's "whole-tablet" approach) and
# switch_root's into it, handing off to systemd as PID 1.
#
# Supersedes the Phase 1/2 bring-up init (docs/phase1-boot-testing.md,
# Round 32/36) - that version's interactive debug shell and USB-gadget
# diagnostics did their job getting the kernel itself proven working;
# this one's job is different; get out of the way and into a real
# userspace as fast and reliably as possible. The USB gadget ACM console
# is kept as a second, independent debug channel alongside the serial
# UART for this first real-rootfs boot milestone - if switch_root or
# systemd itself goes wrong, having two ways to reach a fallback shell
# is worth the small setup cost.

/bin/busybox mkdir -p /proc /sys /dev /newroot
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null

echo "=== gts7l Arch Linux ARM initramfs ==="

# USB gadget serial console (configfs ACM) - best-effort, never let a
# failure here block the real boot attempt below.
/bin/busybox mkdir -p /sys/kernel/config
/bin/busybox mount -t configfs none /sys/kernel/config 2>/dev/null
if [ -d /sys/kernel/config/usb_gadget ]; then
	G=/sys/kernel/config/usb_gadget/g1
	/bin/busybox mkdir -p "$G"
	echo 0x1d6b > "$G/idVendor"
	echo 0x0104 > "$G/idProduct"
	/bin/busybox mkdir -p "$G/strings/0x409"
	echo "gts7l-000000" > "$G/strings/0x409/serialnumber"
	echo "UbuntuTabS7 project" > "$G/strings/0x409/manufacturer"
	echo "gts7l Arch Linux ARM console" > "$G/strings/0x409/product"
	/bin/busybox mkdir -p "$G/configs/c.1/strings/0x409"
	echo "conf1" > "$G/configs/c.1/strings/0x409/configuration"
	echo 120 > "$G/configs/c.1/MaxPower"
	/bin/busybox mkdir -p "$G/functions/acm.usb0"
	/bin/busybox ln -s "$G/functions/acm.usb0" "$G/configs/c.1/"
	UDC=$(/bin/busybox ls /sys/class/udc 2>/dev/null | /bin/busybox head -1)
	if [ -n "$UDC" ]; then
		echo "$UDC" > "$G/UDC"
		i=0
		while [ ! -e /dev/ttyGS0 ] && [ "$i" -lt 50 ]; do
			/bin/busybox sleep 0.1
			i=$((i + 1))
		done
		if [ -e /dev/ttyGS0 ]; then
			echo "=== USB gadget console on /dev/ttyGS0 ==="
			(/bin/busybox setsid /bin/busybox sh -c \
				'exec /bin/busybox sh </dev/ttyGS0 >/dev/ttyGS0 2>&1') &
		fi
	fi
fi

echo "=== mounting root (userdata/archroot, /dev/sda37) ==="
#
# Not using `blkid -L archroot` here: confirmed on real hardware that
# busybox's label-scan mode doesn't reach sda37 at all (a plain `blkid`
# with no args enumerates plenty of other partitions but stops short of
# it), even though `blkid /dev/sda37` directly reports the label
# correctly. This device's partition table is fixed by design (the
# whole-tablet approach in docs/phase5-userspace-scoping.md was chosen
# specifically to avoid ever touching the GPT), so a hardcoded path is
# both simpler and no less reliable than fighting that scan quirk -
# matches this project's own established convention of referencing
# partitions by their known real device node throughout.
ROOT_DEV=/dev/sda37
if [ ! -b "$ROOT_DEV" ]; then
	echo "!!! $ROOT_DEV not found - dropping to a fallback shell"
	exec /bin/busybox sh
fi

echo "=== found root at $ROOT_DEV, mounting ==="
if ! /bin/busybox mount -t ext4 -o rw "$ROOT_DEV" /newroot; then
	echo "!!! failed to mount $ROOT_DEV - dropping to a fallback shell"
	exec /bin/busybox sh
fi

if [ ! -x /newroot/sbin/init ]; then
	echo "!!! /sbin/init missing on the new root - dropping to a fallback shell"
	exec /bin/busybox sh
fi

echo "=== switching root, handing off to systemd ==="
exec /bin/busybox switch_root /newroot /sbin/init

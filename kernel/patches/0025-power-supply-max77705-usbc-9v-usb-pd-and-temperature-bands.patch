 };
 
 static int max77705_bc_ilim_ma(unsigned int chgtyp)
@@ -112,6 +215,61 @@
 	}
 }
 
+static enum max77705_tband max77705_tband(struct max77705_usbc_ilim *ilim)
+{
+	enum max77705_tband prev = ilim->tband;
+	int t, mdegc, ret;
+
+	if (!ilim->batt_therm)
+		return MAX77705_TB_UNKNOWN;
+	ret = iio_read_channel_processed(ilim->batt_therm, &mdegc);
+	if (ret < 0) {
+		dev_warn_ratelimited(ilim->dev, "cannot read battery temperature: %d\n", ret);
+		return MAX77705_TB_UNKNOWN;
+	}
+	t = mdegc / 100;	/* 0.1 C, as the stock tables */
+	if (t < MAX77705_T_VALID_MIN || t > MAX77705_T_VALID_MAX) {
+		dev_warn_ratelimited(ilim->dev, "implausible battery temperature %d\n", t);
+		return MAX77705_TB_UNKNOWN;
+	}
+	ilim->temp = t;
+
+	/* Hysteresis: leaving a band needs the recovery temperature */
+	if (t >= MAX77705_T_STOP_HIGH || t <= MAX77705_T_STOP_LOW)
+		return MAX77705_TB_STOP;
+	if (prev == MAX77705_TB_STOP &&
+	    (t > MAX77705_T_STOP_HIGH_REC || t < MAX77705_T_STOP_LOW_REC))
+		return MAX77705_TB_STOP;
+	if (t >= MAX77705_T_HOT ||
+	    (prev == MAX77705_TB_HOT && t > MAX77705_T_HOT_REC))
+		return MAX77705_TB_HOT;
+	if (t <= MAX77705_T_COLD ||
+	    (prev == MAX77705_TB_COLD && t < MAX77705_T_COLD_REC))
+		return MAX77705_TB_COLD;
+	if (t <= MAX77705_T_COOL ||
+	    (prev == MAX77705_TB_COOL && t < MAX77705_T_COOL_REC))
+		return MAX77705_TB_COOL;
+	return MAX77705_TB_NORMAL;
+}
+
+static int max77705_tband_chg_ma(enum max77705_tband tband, int chg_ma)
+{
+	switch (tband) {
+	case MAX77705_TB_UNKNOWN:
+		return min(chg_ma, MAX77705_CHG_UNKNOWN_MA);
+	case MAX77705_TB_STOP:
+		return MAX77705_CHG_STOP_MA;
+	case MAX77705_TB_COLD:
+		return min(chg_ma, MAX77705_CHG_COLD_MA);
+	case MAX77705_TB_COOL:
+		return min(chg_ma, MAX77705_CHG_COOL_MA);
+	case MAX77705_TB_HOT:
+		return min(chg_ma, MAX77705_CHG_HOT_MA);
+	default:
+		return chg_ma;
+	}
+}

+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ISL98608 LCD bias/boost IC driver, minimal - Samsung Galaxy Tab S7 LTE
+ * (SM-T875, "gts7l").
+ *
+ * This chip supplies the AVDD/AVEE analog bias rails the NT36523/PPA957DB1
+ * LCD panel needs (separate from backlight brightness, which is DCS-based
+ * on this device - see drivers/gpu/drm/panel/panel-novatek-nt36523.c's
+ * gts7l_desc). Samsung's own downstream driver
+ * (references/gts7l/techpack/display/msm/samsung/NT36523_PPA957DB1/
+ * isl98608_hw_i2c.c) does exactly one thing: write 0x02 ("VN & VP 5.5V"
+ * per its own comment) to registers 0x08 and 0x09, called once from their
+ * panel power-on sequence. There is no dynamic enable/disable in their
+ * driver either - this device's "lcd-buck"/"lcd-vdd" rails are already
+ * GPIO-controlled `regulator-boot-on` fixed regulators (see
+ * kernel/dts/sm8250-samsung-gts7l.dts), so doing the same fixed register
+ * program once at i2c probe, independent of the DRM panel's own
+ * prepare/unprepare lifecycle, is a faithful port of the actual downstream
+ * behavior rather than a simplification of it.
+ *
+ * No mainline driver exists for this chip (checked drivers/regulator/ and
+ * drivers/video/backlight/ directly - nothing matches "isl98608").
+ */
+
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+
+#define ISL98608_REG_VP		0x08
+#define ISL98608_REG_VN		0x09
+#define ISL98608_VOLTAGE_5V5	0x02
+
+static int isl98608_gts7l_probe(struct i2c_client *client)
+{
+	int ret;
+
+	/* gts7l temporary diagnostic (docs/kernel-boot-debugging.md) - every
+	 * test so far has consistently reported "backlight off, black
+	 * screen" across completely different underlying DSI/PLL bugs -
+	 * never actually confirmed this driver probes/writes at all,
+	 * since it previously only logged on failure. */
+	pr_err("gts7l: isl98608_gts7l_probe called, i2c addr=0x%02x\n", client->addr);
+
+	ret = i2c_smbus_write_byte_data(client, ISL98608_REG_VP, ISL98608_VOLTAGE_5V5);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "failed to program VP bias\n");
+
+	ret = i2c_smbus_write_byte_data(client, ISL98608_REG_VN, ISL98608_VOLTAGE_5V5);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "failed to program VN bias\n");
+
+	pr_err("gts7l: isl98608_gts7l_probe: both bias registers written successfully\n");
+
+	return 0;

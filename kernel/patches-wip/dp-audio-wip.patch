+
+# DisplayPort audio over USB-C (docs/phase4-usb-dp-scoping.md): MultiMedia3
+# (PCM 2) -> AFE DISPLAY_PORT_RX -> the msm DP controller. The jack follows
+# the monitor's HPD, so the output is only available while one is attached.
+# Lower priority than the speakers: plugging a monitor in doesn't move the
+# sound by itself.
+SectionDevice."HDMI1" {
+	Comment "DisplayPort monitor"
+
+	Value {
+		PlaybackChannels 2
+		PlaybackPriority 50
+		PlaybackPCM "hw:${CardId},2"
+		JackControl "DP0 Jack"
+	}
+}

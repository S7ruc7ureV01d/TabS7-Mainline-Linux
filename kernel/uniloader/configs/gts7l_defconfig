CONFIG_POSITION_INDEPENDENT=y
CONFIG_LINUX_KRNL_HEADER_IMG=y
CONFIG_SM8250=y
CONFIG_SAMSUNG_GTS7L=y
CONFIG_TEXT_BASE=0x90600000
# Round 30 (2026-09-19, docs/kernel-boot-debugging.md): the original
# PAYLOAD_ENTRY (0x91000000) fell INSIDE uniLoader's own ~40.4MiB span
# (0x90600000-0x92e63000, confirmed directly via uniLoader's own
# runtime PC printout) - the memcpy() in arch_load_kernel() was
# overwriting uniLoader's own live code/embedded data while it was still
# executing. Moved both targets to start comfortably after uniLoader's
# real end address, still clear of the splash carveout at 0x9c000000.
#
# Phase 2 (2026-09-19, docs/phase2-panel-scoping.md): the exact same bug
# was about to reoccur. Adding the DRM/DPU/DSI stack (CONFIG_DRM_MSM=y
# etc, kernel/config/gts7l.fragment) grew the embedded kernel Image from
# ~41MB to ~43MB (43,059,712 bytes), which pushed uniLoader's own total
# built size (which embeds that Image, the DTB, and the ramdisk as data)
# past the old 0x93000000 PAYLOAD_ENTRY - confirmed by computing
# TEXT_BASE + the actual built uniLoader binary size
# (44,478,464 bytes -> ends at 0x9306b000) BEFORE flashing, not assumed
# safe just because it was safe before. Moved both addresses out further
# with a large safety margin (64MB between PAYLOAD_ENTRY and
# RAMDISK_ENTRY, comfortably more than the ~43MB kernel needs to leave
# room for further Phase 2 growth) - both still clear of every real
# reserved-memory carveout this device has (checked directly against
# Round 34's live-hardware audit: nothing upstream or Samsung-specific
# occupies 0x90600000-0x98000000 except the small PIL firmware regions
# that already end by ~0x905xxxxx at the latest).
CONFIG_PAYLOAD_ENTRY=0x94000000
CONFIG_RAMDISK_ENTRY=0x98000000

+/*
+ * Samsung Galaxy Tab S7 LTE ("gts7l") board-specific PHY analog trim
+ * override - added following the exact precedent already in this driver
+ * family (dsi_phy_10nm.c's own `struct dsi_phy_10nm_tuning_cfg` /
+ * `dsi_10nm_phy_parse_dt()` / `.parse_dt_properties` hook), since the
+ * generic (quirk-less) SM8250 C-PHY trim constants hardcoded below
+ * ("de-assert digital and pll power down" block) don't match this
+ * board's own PHY calibration - Samsung's downstream GPL kernel source
+ * specifies different values for this exact panel/PHY pairing
+ * (references/gts7l/techpack/display/msm/samsung/NT36523_PPA957DB1/
+ * dsi_panel_NT36523_PPA957DB1_wqxga_video.dtsi:
+ * `samsung,phy_vreg_ctrl_0 = <0x50>`, `samsung,phy_str_swi_cal_sel_ctrl
+ * = <0x04>`, `samsung,phy_offset_top_ctrl = <0x1F>`,
+ * `samsung,phy_offset_bot_ctrl = <0x1F>` - vs. mainline's hardcoded
+ * 0x51/0x03/0x03/0x3c for this generation's C-PHY, no-quirk path), a
+ * plausible direct cause of "DSI PLL(0) lock failed, status=0x00000000"
+ * seen on real hardware since these are exactly the class of register
+ * (LDO bias voltage, resistor-calibration codes) that a PLL's analog
+ * front-end needs correctly trimmed to lock at all. Unlike 10nm's
+ * per-lane rescode-offset arrays, 7nm's equivalent registers
+ * (REG_DSI_7nm_PHY_CMN_GLBL_RESCODE_OFFSET_TOP_CTRL/_BOT_CTRL) are
+ * single global values, not per-lane - so these are plain scalars, not
+ * arrays. Each field is only applied if the devicetree property is
+ * actually present, so every other board/panel using this driver keeps
+ * its existing (untouched) hardcoded behavior.
+ *
+ * Round 55 (docs/kernel-boot-debugging.md): with the DSI command/LP
+ * path now confirmed genuinely working on real hardware (backlight
+ * physically turns on via a DCS write baked into prepare()), while real
+ * HS *video* streaming still deterministically overflows
+ * (VIDEO_MDP_FIFO_OVERFLOW, every round since 43) and produces zero
+ * visible output even for definitely-non-black data written straight
+ * into the real scanout buffer - re-read downstream's dtsi and found a
+ * third rescode-offset property never ported: `samsung,phy_offset_mid_ctrl
+ * = <0x1F>`, alongside the already-ported top/bot. Mainline defines the
+ * matching register
+ * (REG_DSI_7nm_PHY_CMN_GLBL_RESCODE_OFFSET_MID_CTRL, dsi_phy_7nm.xml.h)
+ * but `dsi_7nm_phy_enable()` never writes to it at all - left at
+ * whatever the hardware's power-on-reset value is. C-PHY lanes are
+ * 3-wire trios (vs. D-PHY's 2-wire differential pairs), so a third,
+ * independent calibration code for the "mid" wire is a real, physically
+ * plausible gap - exactly the kind of marginal analog trim that would
+ * degrade tightly-timed HS signaling while barely-tolerant LP/command
+ * signaling keeps working, matching the current symptom split exactly.
+ */
+struct dsi_phy_7nm_tuning_cfg {
+	bool has_vreg_ctrl_0;
+	u8 vreg_ctrl_0;
+	bool has_str_swi_cal_sel_ctrl;
+	u8 str_swi_cal_sel_ctrl;
+	bool has_rescode_top_ctrl;
+	u8 rescode_top_ctrl;
+	bool has_rescode_bot_ctrl;
+	u8 rescode_bot_ctrl;
+	bool has_rescode_mid_ctrl;
+	u8 rescode_mid_ctrl;
+};
+
+static int dsi_7nm_phy_parse_dt(struct msm_dsi_phy *phy)
+{
+	struct device *dev = &phy->pdev->dev;
+	struct dsi_phy_7nm_tuning_cfg *tuning_cfg;
+	u32 val;
+
+	tuning_cfg = devm_kzalloc(dev, sizeof(*tuning_cfg), GFP_KERNEL);
+	if (!tuning_cfg)
+		return -ENOMEM;
+
+	if (!of_property_read_u32(dev->of_node, "qcom,phy-vreg-ctrl-0", &val)) {
+		tuning_cfg->has_vreg_ctrl_0 = true;
+		tuning_cfg->vreg_ctrl_0 = val;
+	}
+
+	if (!of_property_read_u32(dev->of_node, "qcom,phy-str-swi-cal-sel-ctrl", &val)) {
+		tuning_cfg->has_str_swi_cal_sel_ctrl = true;
+		tuning_cfg->str_swi_cal_sel_ctrl = val;
+	}
+
+	if (!of_property_read_u32(dev->of_node, "qcom,phy-rescode-offset-top-ctrl", &val)) {
+		tuning_cfg->has_rescode_top_ctrl = true;
+		tuning_cfg->rescode_top_ctrl = val;
+	}
+
+	if (!of_property_read_u32(dev->of_node, "qcom,phy-rescode-offset-bot-ctrl", &val)) {
+		tuning_cfg->has_rescode_bot_ctrl = true;
+		tuning_cfg->rescode_bot_ctrl = val;
+	}
+
+	if (!of_property_read_u32(dev->of_node, "qcom,phy-rescode-offset-mid-ctrl", &val)) {
+		tuning_cfg->has_rescode_mid_ctrl = true;
+		tuning_cfg->rescode_mid_ctrl = val;
+	}
+
+	phy->tuning_cfg = tuning_cfg;
+
+	return 0;
+}

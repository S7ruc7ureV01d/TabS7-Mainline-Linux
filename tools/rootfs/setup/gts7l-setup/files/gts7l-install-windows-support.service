# Installs Wine for Windows programs (Hangover: Wine + FEX/Box64) if "Windows
# programs" was chosen during first-boot setup. A background job: it waits
# for the internet itself (no failure at boot when offline), installs, tells
# the user and disables itself.
[Unit]
Description=Install Windows program support (Wine/Hangover)
ConditionPathExists=!/opt/hangover/bin/wine

[Service]
Type=simple
ExecStart=/usr/lib/gts7l-setup/gts7l-windows-support

[Install]
WantedBy=multi-user.target

+		      MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM,
+	.init_sequence = gts7l_init_sequence,
+	.is_dual_dsi = true,
+	/*
+	 * Round 46 (2026-09-19, docs/kernel-boot-debugging.md) set this to
+	 * `false` because nt36523_bl_update_status()'s automatic initial
+	 * brightness write landed within 1ms of every
+	 * dsi_err_worker: status=4 (DSI_ERR_STATE_FIFO) failure, theorized
+	 * as an unsynchronized dsi->mode_flags race with the DRM commit
+	 * path. Round 48 directly retracted this: with the callback removed
+	 * entirely, the identical FIFO fault still fired at the same timing
+	 * - "the backlight race was a coincidental correlation, not the
+	 * actual cause - both were triggered by the same underlying event
+	 * (the first real frame commit), not one causing the other." That
+	 * retraction was never acted on - `has_dcs_backlight` stayed `false`
+	 * through Rounds 47-51 by omission, not by any new evidence against
+	 * it, while five more rounds chased the (separately confirmed
+	 * harmless - see Round 52 in docs/kernel-boot-debugging.md;
+	 * dsi_err_worker only calls dsi_sw_reset() for
+	 * DSI_FIFO_STATUS_CMD_MDP_FIFO_UNDERFLOW, bit 0x80, which our
+	 * observed 0x1ddd1011 never sets) FIFO log line. Meanwhile this
+	 * panel's backlight is DCS-controlled by the panel's own internal
+	 * LED driver (downstream's `bl_ctrl_dcs`, register 0x51) - not a
+	 * separate GPIO/PWM rail - so with no backlight device registered at
+	 * all, nothing has sent a brightness-on command in any of those
+	 * rounds regardless of whether the DSI/DPU pipeline was healthy.
+	 * Reverted to `true` to restore the only code path that actually
+	 * turns the backlight on, now that its only cited justification for
+	 * being off is known-retracted.
+	 */
+	.has_dcs_backlight = true,
+};

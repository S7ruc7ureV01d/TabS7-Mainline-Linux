 #define MAX77705_USBC_REG_UIC_INT	0x02
 #define MAX77705_USBC_REG_CC_INT	0x03
 #define MAX77705_USBC_REG_PD_INT	0x04
 #define MAX77705_USBC_REG_VDM_INT	0x05
+#define MAX77705_USBC_REG_STATUS1	0x06
 #define MAX77705_USBC_REG_BC_STATUS	0x08
 #define MAX77705_USBC_REG_CC_STATUS0	0x0a
+#define MAX77705_USBC_REG_PD_STATUS0	0x0c
 #define MAX77705_USBC_REG_UIC_INT_M	0x0e
 #define MAX77705_USBC_REG_CC_INT_M	0x0f
+#define MAX77705_USBC_REG_PD_INT_M	0x10
+#define MAX77705_USBC_REG_OPCODE_W	0x21
+#define MAX77705_USBC_REG_OPCODE_END	0x41
+#define MAX77705_USBC_REG_OPCODE_R	0x51
+#define MAX77705_USBC_OPCODE_LEN	33	/* opcode + 32 data bytes */
+#define MAX77705_USBC_MAX_REG		(MAX77705_USBC_REG_OPCODE_R + \
+					 MAX77705_USBC_OPCODE_LEN - 1)
 
 /* UIC_INT(_M) */
+#define MAX77705_APCMDRESI		BIT(7)
 #define MAX77705_VBUSDETI		BIT(5)
 #define MAX77705_CHGTYPI		BIT(1)
 /* CC_INT(_M) */
 #define MAX77705_CCISTATI		BIT(2)
 #define MAX77705_CCSTATI		BIT(0)
+/* PD_INT(_M) */
+#define MAX77705_PDMSGI			BIT(7)

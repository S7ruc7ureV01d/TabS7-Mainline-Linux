# Local reference clones (prior-art repos) - not part of this project's history
references/*/
!references/README.md

# Build scratch space (kernel source checkouts, build output, logs) - not versioned
work/

# Generated release files (built images, etc.) - not versioned, see PROVENANCE
# docs alongside them for how to regenerate and verify
artifacts/

# makepkg output when packages are built in place
tools/rootfs/**/src/
tools/rootfs/**/pkg/
tools/rootfs/**/*.pkg.tar.*

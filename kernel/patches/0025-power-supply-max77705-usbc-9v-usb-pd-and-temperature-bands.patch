@@ -70,17 +115,75 @@
 #define MAX77705_ILIM_1500_MA		1500
 #define MAX77705_ILIM_TA_MA		1800
 #define MAX77705_CHG_TA_MA		2100
+/* Stock 9 V: 1650 mA input (pd_charging_charge_power 15 W), 3150 charge */
+#define MAX77705_PD_MV			9000
+#define MAX77705_ILIM_9V_MA		1650
+#define MAX77705_CHG_9V_MA		3150
+
+/*
+ * Stock battery temperature bands (0.1 C). Hot: swelling_high_temp_block
+ * 42.0/40.0 C; stock also drops the float voltage there, which the charger
+ * driver can't, so the current is cut well below stock's 2750 mA. Stop:
+ * temp_high/low_threshold 50.0/48.0 C and 0.0/2.0 C. Cold: swelling low
+ * temp 15.0/17.0 C (1850 mA) and 5.0/7.0 C (750 mA).
+ */
+#define MAX77705_T_STOP_HIGH		500
+#define MAX77705_T_STOP_HIGH_REC	480
+#define MAX77705_T_HOT			420
+#define MAX77705_T_HOT_REC		400
+#define MAX77705_T_COOL			150
+#define MAX77705_T_COOL_REC		170
+#define MAX77705_T_COLD			50
+#define MAX77705_T_COLD_REC		70
+#define MAX77705_T_STOP_LOW		0
+#define MAX77705_T_STOP_LOW_REC		20
+#define MAX77705_CHG_HOT_MA		1000
+#define MAX77705_CHG_COOL_MA		1850
+#define MAX77705_CHG_COLD_MA		750
+#define MAX77705_CHG_STOP_MA		100	/* the charger's minimum */
+#define MAX77705_CHG_UNKNOWN_MA		1000
+#define MAX77705_T_VALID_MIN		-400	/* outside: sensor fault */
+#define MAX77705_T_VALID_MAX		1000
+
+enum max77705_tband {
+	MAX77705_TB_UNKNOWN,
+	MAX77705_TB_STOP,
+	MAX77705_TB_COLD,
+	MAX77705_TB_COOL,
+	MAX77705_TB_NORMAL,
+	MAX77705_TB_HOT,
+};
+
+enum max77705_pd_state {
+	MAX77705_PD_IDLE,	/* nothing asked this attach */
+	MAX77705_PD_READING,	/* OPCODE_CURRENT_SRCCAP sent */
+	MAX77705_PD_REQUESTED,	/* OPCODE_SRCCAP_REQUEST sent */
+	MAX77705_PD_9V,		/* 9 V contract confirmed */
+	MAX77705_PD_DONE,	/* nothing (more) to do this attach */
+};
 
-/* CC advertisement and BC1.2 result settle over ~0.5 s after attach */
-#define MAX77705_ILIM_DEBOUNCE_MS	300
+/* CC and BC1.2 results settle over ~0.5 s after attach */
+#define MAX77705_DEBOUNCE_MS		300
+#define MAX77705_POLL_MS		30000	/* temperature, while attached */
+#define MAX77705_PD_TIMEOUT_MS		3000
 
 struct max77705_usbc_ilim {
 	struct device *dev;
 	struct regmap *regmap;
 	struct power_supply *charger;
+	struct iio_channel *batt_therm;
 	struct mutex lock;
 	struct delayed_work work;
+	struct delayed_work pd_timeout;
+	enum max77705_tband tband;
+	enum max77705_pd_state pd;
+	bool attached;
+	bool psrdy;
+	bool cmd_done;
+	int pdo_ma;

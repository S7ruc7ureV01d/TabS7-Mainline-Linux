 static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 			      struct msm_dsi_phy_clk_request *clk_req)
 {
@@ -967,6 +1065,7 @@ static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 	u32 glbl_pemph_ctrl_0;
 	u32 glbl_str_swi_cal_sel_ctrl, glbl_hstx_str_ctrl_0;
 	u32 glbl_rescode_top_ctrl, glbl_rescode_bot_ctrl;
+	u32 glbl_rescode_mid_ctrl = 0x00;
 	u32 data;
 
 	DBG("");
@@ -1084,6 +1183,24 @@ static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 		glbl_rescode_bot_ctrl = 0x3c;
 	}
 
+	/* Board-specific PHY trim override, if this device's devicetree
+	 * provided one - see the dsi_phy_7nm_tuning_cfg comment above.
+	 */
+	if (phy->tuning_cfg) {
+		struct dsi_phy_7nm_tuning_cfg *tuning_cfg = phy->tuning_cfg;
+
+		if (tuning_cfg->has_vreg_ctrl_0)
+			vreg_ctrl_0 = tuning_cfg->vreg_ctrl_0;
+		if (tuning_cfg->has_str_swi_cal_sel_ctrl)
+			glbl_str_swi_cal_sel_ctrl = tuning_cfg->str_swi_cal_sel_ctrl;
+		if (tuning_cfg->has_rescode_top_ctrl)
+			glbl_rescode_top_ctrl = tuning_cfg->rescode_top_ctrl;
+		if (tuning_cfg->has_rescode_bot_ctrl)
+			glbl_rescode_bot_ctrl = tuning_cfg->rescode_bot_ctrl;
+		if (tuning_cfg->has_rescode_mid_ctrl)
+			glbl_rescode_mid_ctrl = tuning_cfg->rescode_mid_ctrl;
+	}
+
 	/* de-assert digital and pll power down */
 	data = DSI_7nm_PHY_CMN_CTRL_0_DIGTOP_PWRDN_B |
 	       DSI_7nm_PHY_CMN_CTRL_0_PLL_SHUTDOWNB;
@@ -1125,6 +1242,8 @@ static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 	       base + REG_DSI_7nm_PHY_CMN_GLBL_RESCODE_OFFSET_TOP_CTRL);
 	writel(glbl_rescode_bot_ctrl,
 	       base + REG_DSI_7nm_PHY_CMN_GLBL_RESCODE_OFFSET_BOT_CTRL);
+	writel(glbl_rescode_mid_ctrl,
+	       base + REG_DSI_7nm_PHY_CMN_GLBL_RESCODE_OFFSET_MID_CTRL);
 	writel(0x55, base + REG_DSI_7nm_PHY_CMN_GLBL_LPTX_STR_CTRL);
 
 	/* Remove power down from all blocks */
@@ -1271,6 +1390,7 @@ const struct msm_dsi_phy_cfg dsi_phy_7nm_cfgs = {
 		.save_pll_state = dsi_7nm_pll_save_state,
 		.restore_pll_state = dsi_7nm_pll_restore_state,
 		.set_continuous_clock = dsi_7nm_set_continuous_clock,
+		.parse_dt_properties = dsi_7nm_phy_parse_dt,
 	},
 	.min_pll_rate = 600000000UL,
 #ifdef CONFIG_64BIT

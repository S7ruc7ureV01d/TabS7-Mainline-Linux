# Audio gate for the Galaxy Tab S7's speaker amps (docs/phase3-audio-scoping.md).
# Only root may use the sound card, unless gts7l-audio-safe has verified
# this boot that all four amps are in their safe state (protection DSP
# in the path). It re-triggers these devices once it has, and then the
# seat user gets them through the usual uaccess ACL.
SUBSYSTEM=="sound", KERNEL=="pcmC*|controlC*|comprC*|hwC*", TAG-="uaccess", OWNER="root", GROUP="root", MODE="0600"
SUBSYSTEM=="sound", KERNEL=="pcmC*|controlC*|comprC*|hwC*", TEST=="/run/gts7l-audio-safe.ok", GROUP="audio", MODE="0660", TAG+="uaccess"

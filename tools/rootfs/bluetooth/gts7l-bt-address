#!/bin/sh
# Give the QCA6390 Bluetooth controller its address. The chip has no address
# of its own (it reports a QCA placeholder), so the kernel keeps it
# "unconfigured" until one is set (the DT's local-bd-address is all zeros:
# one image serves every unit). The installer writes this unit's factory
# address, from Samsung's /efs/bluetooth/bt_addr, to /etc/gts7l/bt-address;
# without it, a random locally administered address is made once and kept.
set -eu

CONF=/etc/gts7l/bt-address

if [ ! -s "$CONF" ]; then
	mkdir -p "$(dirname "$CONF")"
	# locally administered, unicast: first octet xxxxxx10
	set -- $(od -An -N6 -tx1 /dev/urandom)
	first=$(printf '%02x' $(( (0x$1 & 0xfc) | 0x02 )))
	echo "$first:$2:$3:$4:$5:$6" > "$CONF"
fi
ADDR=$(tr -d ' \n\r' < "$CONF")

# wait for hci0 (re-created by bt-uart-rebind once firmware is reachable)
i=0
while [ ! -e /sys/class/bluetooth/hci0 ] && [ $i -lt 60 ]; do
	sleep 0.5
	i=$((i + 1))
done
[ -e /sys/class/bluetooth/hci0 ] || { echo "no hci0"; exit 0; }

# already configured with it (e.g. a second run)
if btmgmt --index 0 info 2>/dev/null | grep -qi "addr $ADDR"; then
	exit 0
fi
exec btmgmt --index 0 public-addr "$ADDR"

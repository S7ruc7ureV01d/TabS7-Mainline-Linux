+	dev_info(ilim->dev, "%s: input %d mA, charge %d mA (battery %d.%d C, band %d)\n",
+		 why, ilim_ma, chg_ma, ilim->temp / 10, abs(ilim->temp % 10),
+		 ilim->tband);
+	ilim->ilim_ma = ilim_ma;
+	ilim->chg_ma = chg_ma;
+}
+
+/* Called with ilim->lock held */
+static int max77705_opcode(struct max77705_usbc_ilim *ilim, u8 opcode,
+			   const u8 *data, size_t len)
+{
+	u8 buf[2] = { opcode };
+	int ret;
+
+	if (len > sizeof(buf) - 1)
+		return -EINVAL;
+	if (len)
+		memcpy(&buf[1], data, len);
+
+	ilim->cmd_done = false;
+	ret = regmap_bulk_write(ilim->regmap, MAX77705_USBC_REG_OPCODE_W, buf,
+				len + 1);
+	/* The end marker makes the firmware execute the command */
+	if (!ret)
+		ret = regmap_write(ilim->regmap, MAX77705_USBC_REG_OPCODE_END, 0);
+	if (ret)
+		dev_warn(ilim->dev, "cannot send opcode 0x%02x: %d\n", opcode, ret);
+	return ret;
+}
+
+/* Called with ilim->lock held: act on a finished firmware command */
+static void max77705_pd_reply(struct max77705_usbc_ilim *ilim)
+{
+	u8 r[MAX77705_USBC_OPCODE_LEN];
+	int i, num, sel, best = 0, best_ma = 0;
+	u8 pos;
+
+	if (regmap_bulk_read(ilim->regmap, MAX77705_USBC_REG_OPCODE_R, r, sizeof(r)))
+		return;
+
+	if (ilim->pd == MAX77705_PD_READING && r[0] == MAX77705_OP_CURRENT_SRCCAP) {
+		sel = FIELD_GET(MAX77705_SRCCAP_SEL, r[1]);
+		num = FIELD_GET(MAX77705_SRCCAP_NUM, r[1]);
+
+		for (i = 0; i < num; i++) {
+			u32 pdo = get_unaligned_le32(&r[2 + i * 4]);
+
+			if (FIELD_GET(PDO_TYPE, pdo) != PDO_TYPE_FIXED ||
+			    FIELD_GET(PDO_FIXED_VOLT, pdo) * 50 != MAX77705_PD_MV)
+				continue;
+			best = i + 1;
+			best_ma = FIELD_GET(PDO_FIXED_CURR, pdo) * 10;
+			break;
+		}
+
+		/* Not worth it below the 5 V TA's power */
+		if (!best || best_ma * MAX77705_PD_MV < MAX77705_ILIM_TA_MA * 5000) {
+			dev_info(ilim->dev, "PD source: %d PDOs, no usable fixed 9 V\n", num);
+			ilim->pd = MAX77705_PD_DONE;
+			return;
+		}
+
+		ilim->pdo_ma = min(best_ma, MAX77705_ILIM_9V_MA);
+		if (best == sel) {
+			/* already at 9 V: confirmed by the next update */
+			ilim->pd = MAX77705_PD_REQUESTED;
+			ilim->psrdy = true;
+			return;
+		}
+
+		/* The 9 V input limit is safe at 5 V too: set it first */
+		max77705_apply(ilim, ilim->pdo_ma,
+			       max77705_tband_chg_ma(ilim->tband, MAX77705_CHG_TA_MA),
+			       "before 9 V");
+		dev_info(ilim->dev, "PD source: requesting PDO %d (9 V, %d mA)\n",
+			 best, best_ma);
+		pos = best;
+		ilim->psrdy = false;
+		if (max77705_opcode(ilim, MAX77705_OP_SRCCAP_REQUEST, &pos, 1)) {
+			ilim->pd = MAX77705_PD_DONE;
+			return;
+		}
+		ilim->pd = MAX77705_PD_REQUESTED;
+		mod_delayed_work(system_wq, &ilim->pd_timeout,
+				 msecs_to_jiffies(MAX77705_PD_TIMEOUT_MS));
+		return;
+	}
+
+	/* 0xfe/0xff: the request could not be sent to the source */
+	if (ilim->pd == MAX77705_PD_REQUESTED && r[0] == MAX77705_OP_SRCCAP_REQUEST &&
+	    (r[1] == 0xfe || r[1] == 0xff)) {
+		dev_info(ilim->dev, "PD request not sent (0x%02x), staying at 5 V\n", r[1]);
+		ilim->pd = MAX77705_PD_DONE;
+	}
+}
+
+static void max77705_update(struct max77705_usbc_ilim *ilim)
+{
+	unsigned int bc, cc0, st1, chgtyp, ccistat;
+	int ilim_ma, chg_ma;
+	bool vbus_9v;
 
 	if (regmap_read(ilim->regmap, MAX77705_USBC_REG_BC_STATUS, &bc) ||
-	    regmap_read(ilim->regmap, MAX77705_USBC_REG_CC_STATUS0, &cc0)) {
+	    regmap_read(ilim->regmap, MAX77705_USBC_REG_CC_STATUS0, &cc0) ||
+	    regmap_read(ilim->regmap, MAX77705_USBC_REG_STATUS1, &st1)) {
 		dev_warn(ilim->dev, "cannot read USB-C status\n");
 		return;
 	}
+	vbus_9v = FIELD_GET(MAX77705_VBADC, st1) == MAX77705_VBADC_8V5_9V5;
 
-	/* Nothing to do without VBUS; the next attach sets a fresh limit */
-	if (!(bc & MAX77705_BC_VBUSDET))
-		return;
+	mutex_lock(&ilim->lock);
 
-	chgtyp = FIELD_GET(MAX77705_BC_CHGTYP, bc);
-	ccistat = FIELD_GET(MAX77705_CC_CCISTAT, cc0);
+	/* Detach: forget this attach's PD state; the next one starts at 5 V */
+	if (!(bc & MAX77705_BC_VBUSDET)) {
+		ilim->attached = false;
+		ilim->pd = MAX77705_PD_IDLE;
+		ilim->psrdy = false;
+		ilim->cmd_done = false;
+		cancel_delayed_work(&ilim->pd_timeout);
+		goto out;
+	}
+	ilim->attached = true;
+	ilim->tband = max77705_tband(ilim);
+
+	if (ilim->cmd_done) {
+		ilim->cmd_done = false;
+		max77705_pd_reply(ilim);
+	}
+
+	/* The 9 V contract counts once the firmware and the VBUS ADC agree */
+	if (ilim->pd == MAX77705_PD_REQUESTED && ilim->psrdy && vbus_9v) {
+		cancel_delayed_work(&ilim->pd_timeout);
+		ilim->pd = MAX77705_PD_9V;
+	} else if (ilim->pd == MAX77705_PD_9V && !vbus_9v) {
+		dev_info(ilim->dev, "VBUS left 9 V\n");
+		ilim->pd = MAX77705_PD_DONE;
+	}
+
+	if (ilim->pd == MAX77705_PD_9V) {
+		chg_ma = max77705_tband_chg_ma(ilim->tband, MAX77705_CHG_9V_MA);
+		max77705_apply(ilim, ilim->pdo_ma, chg_ma, "9 V PD");
+		goto out;
+	}
+
+	/* Keep the 9 V input limit while the request settles */
+	if (ilim->pd == MAX77705_PD_READING || ilim->pd == MAX77705_PD_REQUESTED)
+		goto out;
 
 	/*
 	 * Neither result yet (attach in progress) or any more (VBUS still
 	 * decaying after detach): keep the current setting.
 	 */
+	chgtyp = FIELD_GET(MAX77705_BC_CHGTYP, bc);
+	ccistat = FIELD_GET(MAX77705_CC_CCISTAT, cc0);
 	ilim_ma = max(max77705_bc_ilim_ma(chgtyp), max77705_cc_ilim_ma(ccistat));

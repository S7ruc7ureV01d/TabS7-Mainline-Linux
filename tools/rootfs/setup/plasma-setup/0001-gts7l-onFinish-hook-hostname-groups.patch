diff -ru a/src/qml/Wizard.qml b/src/qml/Wizard.qml
--- a/src/qml/Wizard.qml	2026-09-25 00:25:16.299374823 -0300
+++ b/src/qml/Wizard.qml	2026-09-25 00:25:16.323619735 -0300
@@ -73,6 +73,15 @@
     }
 
     function finishFinalPage(): void {
+        // gts7l: let distro modules apply their choices first, through an
+        // optional `onFinish` function (like `onPageActivated`).
+        for (let i = 0; i < stepCount; i++) {
+            let item = stepsRepeater.itemAt(i);
+            if (item && item.module && typeof item.module.onFinish === "function") {
+                item.module.onFinish();
+            }
+        }
+
         // Finalize the initial setup process and exit the wizard.
         InitialStartUtil.finish();
     }

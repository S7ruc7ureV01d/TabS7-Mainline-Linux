[Unit]
Description=8 GiB swap file on the root filesystem (created on first boot)
DefaultDependencies=no
After=local-fs.target
Before=swap.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# First boot: create it (mkswap --file allocates it without holes, mode 0600)
ExecStartPre=/bin/sh -c '[ -e /swapfile ] || mkswap --file /swapfile --size 8G'
ExecStart=/usr/bin/swapon /swapfile
ExecStop=/usr/bin/swapoff /swapfile

[Install]
WantedBy=swap.target

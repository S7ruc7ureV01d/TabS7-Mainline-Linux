From: gts7l project
Subject: [PATCH] ASoC: qdsp6: q6afe: send TDM data-out, invert-sync and
 data-delay to the ADSP

q6afe-dai reads qcom,tdm-data-out, qcom,tdm-invert-sync and
qcom,tdm-data-delay from DT (and requires them), but never copies them
into the port config. So AFE_PARAM_ID_TDM_CONFIG always went out with
ctrl_data_out_enable, ctrl_invert_sync_pulse and ctrl_sync_data_delay at
0, whatever the DT said.

On the Galaxy Tab S7 the speaker amps use DSP_A framing, which needs
data-delay 1 as stock sets it. With the delay stuck at 0, slot 0 played
clean but slots 1-3 crackled.

Carry the three values through q6afe_tdm_cfg into the TDM config.

--- a/sound/soc/qcom/qdsp6/q6afe-dai.c
+++ b/sound/soc/qcom/qdsp6/q6afe-dai.c
@@ -278,6 +278,9 @@
 	tdm->data_align_type = dai_data->priv[dai->id].data_align;
 	tdm->sync_src = dai_data->priv[dai->id].sync_src;
 	tdm->sync_mode = dai_data->priv[dai->id].sync_mode;
+	tdm->data_out_enable = dai_data->priv[dai->id].data_out_enable;
+	tdm->invert_sync = dai_data->priv[dai->id].invert_sync;
+	tdm->data_delay = dai_data->priv[dai->id].data_delay;
 
 	return 0;
 }
--- a/sound/soc/qcom/qdsp6/q6afe.c
+++ b/sound/soc/qcom/qdsp6/q6afe.c
@@ -1362,6 +1362,9 @@
 	pcfg->tdm_cfg.sync_mode = cfg->sync_mode;
 	pcfg->tdm_cfg.sync_src = cfg->sync_src;
 	pcfg->tdm_cfg.nslots_per_frame = cfg->nslots_per_frame;
+	pcfg->tdm_cfg.ctrl_data_out_enable = cfg->data_out_enable;
+	pcfg->tdm_cfg.ctrl_invert_sync_pulse = cfg->invert_sync;
+	pcfg->tdm_cfg.ctrl_sync_data_delay = cfg->data_delay;
 
 	pcfg->tdm_cfg.slot_width = cfg->slot_width;
 	pcfg->tdm_cfg.slot_mask = cfg->slot_mask;
--- a/sound/soc/qcom/qdsp6/q6afe.h
+++ b/sound/soc/qcom/qdsp6/q6afe.h
@@ -190,6 +190,9 @@
 	u16	sync_mode;
 	u16	sync_src;
 	u16	nslots_per_frame;
+	u16	data_out_enable;
+	u16	invert_sync;
+	u16	data_delay;
 	u16	slot_width;
 	u16	slot_mask;
 	u32	data_align_type;

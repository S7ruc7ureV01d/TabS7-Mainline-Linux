-static void max77705_usbc_ilim_update(struct max77705_usbc_ilim *ilim)
+/* Called with ilim->lock held */
+static void max77705_apply(struct max77705_usbc_ilim *ilim, int ilim_ma,
+			   int chg_ma, const char *why)
 {
-	unsigned int bc, cc0, chgtyp, ccistat;
-	int ilim_ma, chg_ma, ret;
+	int ret;
+
+	if (ilim_ma == ilim->ilim_ma && chg_ma == ilim->chg_ma)
+		return;
+
+	ret = max77705_set_ma(ilim, POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, ilim_ma);
+	if (!ret)
+		ret = max77705_set_ma(ilim, POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
+				      chg_ma);

+	       phy->id, phy->cphy_mode, clk_req->bitclk_rate, phy->tuning_cfg);
+
 	DBG("");
 
 	if (phy->cphy_mode)
@@ -1084,6 +1169,28 @@ static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 		glbl_rescode_bot_ctrl = 0x3c;
 	}
 
+	/* Board-specific PHY trim override, if this device's devicetree
+	 * provided one - see the dsi_phy_7nm_tuning_cfg comment above.
+	 */
+	if (phy->tuning_cfg) {
+		struct dsi_phy_7nm_tuning_cfg *tuning_cfg = phy->tuning_cfg;
+
+		if (tuning_cfg->has_vreg_ctrl_0)
+			vreg_ctrl_0 = tuning_cfg->vreg_ctrl_0;
+		if (tuning_cfg->has_str_swi_cal_sel_ctrl)
+			glbl_str_swi_cal_sel_ctrl = tuning_cfg->str_swi_cal_sel_ctrl;
+		if (tuning_cfg->has_rescode_top_ctrl)
+			glbl_rescode_top_ctrl = tuning_cfg->rescode_top_ctrl;
+		if (tuning_cfg->has_rescode_bot_ctrl)
+			glbl_rescode_bot_ctrl = tuning_cfg->rescode_bot_ctrl;
+	}
+
+	/* gts7l temporary diagnostic - final trim values about to be
+	 * written to hardware. */
+	pr_err("gts7l: phy%d trim: vreg_ctrl_0=0x%x str_swi_cal_sel_ctrl=0x%x rescode_top=0x%x rescode_bot=0x%x\n",
+	       phy->id, vreg_ctrl_0, glbl_str_swi_cal_sel_ctrl,
+	       glbl_rescode_top_ctrl, glbl_rescode_bot_ctrl);
+
 	/* de-assert digital and pll power down */
 	data = DSI_7nm_PHY_CMN_CTRL_0_DIGTOP_PWRDN_B |
 	       DSI_7nm_PHY_CMN_CTRL_0_PLL_SHUTDOWNB;
@@ -1271,6 +1378,7 @@ const struct msm_dsi_phy_cfg dsi_phy_7nm_cfgs = {
 		.save_pll_state = dsi_7nm_pll_save_state,
 		.restore_pll_state = dsi_7nm_pll_restore_state,
 		.set_continuous_clock = dsi_7nm_set_continuous_clock,
+		.parse_dt_properties = dsi_7nm_phy_parse_dt,
 	},
 	.min_pll_rate = 600000000UL,

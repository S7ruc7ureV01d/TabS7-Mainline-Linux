 asmlinkage __visible __init __no_sanitize_address __noreturn __no_stack_protector
+/*
+ * Round 29 debug console (docs/kernel-boot-debugging.md, UbuntuTabS7
+ * project) - a minimal, direct-physical-write console that writes printk
+ * output into Samsung's own persistent sec_log_buf ring
+ * (`sec_log=0x200000@0x9F200000`, confirmed live via this device's own
+ * `/proc/cmdline` while stock/TWRP is booted - the exact same buffer
+ * `/proc/last_kmsg` reads from, proven reliable across dozens of reads
+ * throughout this entire debugging effort). Struct layout confirmed
+ * against this device's real downstream source
+ * (references/gts7l/include/linux/samsung/debug/sec_log_buf.h).
+ *
+ * Registered as early as architecturally possible - right after
+ * setup_arch() establishes the kernel's real linear map on arm64, long
+ * before core_initcall timing (where the real sec_log driver, and the
+ * reference patch this is adapted from - postmarketOS's Galaxy Tab S9
+ * Ultra port - both register it). This project's own testing (Round 24)
+ * already showed this kernel's hang happens before
+ * lockup_detector_init() can even arm, which is itself earlier than
+ * core_initcall - a late-registered console would never have a chance to
+ * capture anything.
+ *
+ * TWRP's own kernel already reads this exact format via /proc/last_kmsg
+ * (references/gts7l/drivers/samsung/debug/sec_log_buf.c) - no new reader
+ * needed, just a byte-compatible writer.
+ */
+#define SEC_LOG_PADDR	0x9F200000UL
+#define SEC_LOG_SIZE	0x200000UL
+#define SEC_LOG_MAGIC	0x4d474f4c /* "LOGM" */
+
+struct sec_log_buf_hdr {
+	u32 boot_cnt;
+	u32 magic;
+	u32 idx;
+	u32 prev_idx;
+	char buf[];
+};
+
+static struct sec_log_buf_hdr *early_sec_log;
+static size_t early_sec_log_data_size;
+
+static void early_sec_log_write(struct console *co, const char *s,
+				 unsigned int count)
+{
+	unsigned int idx, f_len, s_len, remain;
+
+	if (!early_sec_log)
+		return;
+
+	idx = early_sec_log->idx % early_sec_log_data_size;
+	remain = early_sec_log_data_size - idx;
+	f_len = min(count, remain);
+	memcpy(&early_sec_log->buf[idx], s, f_len);
+	s_len = count - f_len;
+	if (s_len)
+		memcpy(early_sec_log->buf, s + f_len, s_len);
+	early_sec_log->idx += count;
+}
+
+static struct console early_sec_log_console = {
+	.name = "earlyseclog",
+	.write = early_sec_log_write,
+	.flags = CON_ENABLED | CON_PRINTBUFFER | CON_ANYTIME,
+	.index = -1,
+};
+
+static void __init early_sec_log_init(void)
+{
+	struct sec_log_buf_hdr *hdr = phys_to_virt(SEC_LOG_PADDR);
+
+	early_sec_log_data_size = SEC_LOG_SIZE - offsetof(struct sec_log_buf_hdr, buf);
+
+	if (hdr->magic != SEC_LOG_MAGIC) {
+		hdr->magic = SEC_LOG_MAGIC;
+		hdr->idx = 0;
+		hdr->prev_idx = 0;
+	}
+	hdr->boot_cnt++;
+
+	early_sec_log = hdr;
+	register_console(&early_sec_log_console);
+}
+
 void start_kernel(void)
 {
 	char *command_line;
@@ -992,6 +1074,7 @@ void start_kernel(void)
 	page_address_init();
 	pr_notice("%s", linux_banner);
 	setup_arch(&command_line);
+	early_sec_log_init();
 	mm_core_init_early();
 	/* Static keys and static calls are needed by LSMs */
 	jump_label_init();

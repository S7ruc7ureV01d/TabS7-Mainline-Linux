From: gts7l project
Subject: [PATCH] ASoC: qcom: sm8250: primary TDM for the Galaxy Tab S7's
 CS35L41 speaker amps

The SM8250 machine driver only handled MI2S back-ends. The Galaxy Tab S7
LTE (gts7l) drives its four CS35L41 speaker amps over PRIMARY_TDM_RX_0,
exactly as Samsung's downstream kona.c does (msm_tdm_be_dai_links[]):
DSP_A, amps as bit/frame clock consumers, inverted bit clock, 4 x 32-bit
slots at 48 kHz (BCLK 6.144 MHz), one slot per amp.

Modelled on sdm845.c's TDM handling:
- startup: PRI_TDM_IBIT clock at 6.144 MHz, and codec format
  CBC_CFC | DSP_A | IB_NF on every amp.
- hw_params: CPU slots and channel map (offsets 0/4/8/12). Amp i gets
  RX1 = slot i (RX2 unused = 7) and VI feedback TX1 = slot i, which
  matches stock mixer_paths.xml's ASPRX1/ASPTX1 positions for FL/FR/RL/RR
  when the codecs are listed in that order. Each amp's PLL runs from
  SCLK.
- be_hw_params_fixup: 4 channels S16_LE for this port, as stock's
  kona.c (tdm_rx_cfg PRI RX_0) and mixer_paths ("PRI_TDM_RX_0 Channels"
  = Four). The samples sit in 32-bit slots, so each amp also gets
  set_tdm_slot(4, 32) (stock: cirrus,fixed-width = 32; needs 0019).
  Other back-ends are unchanged.
- init: no jack setup on the speaker link.

--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -10,6 +10,7 @@
 #include <sound/pcm_params.h>
 #include <linux/soundwire/sdw.h>
 #include <sound/jack.h>
+#include <sound/cs35l41.h>
 #include <linux/input-event-codes.h>
 #include "qdsp6/q6afe.h"
 #include "common.h"
@@ -18,6 +19,18 @@
 
 #define MI2S_BCLK_RATE		1536000
 
+/*
+ * Primary TDM to the Galaxy Tab S7's four CS35L41 speaker amps: 4 slots x
+ * 32 bits at 48 kHz (BCLK 6.144 MHz), DSP_A, inverted bit clock, amps as
+ * clock consumers, one slot per amp in DAI-link codec order.
+ */
+#define TDM_SLOTS		4
+#define TDM_SLOT_WIDTH		32
+#define TDM_BCLK_RATE		(48000 * TDM_SLOTS * TDM_SLOT_WIDTH)
+#define TDM_UNUSED_SLOT		7
+
+static unsigned int tdm_slot_offset[TDM_SLOTS] = {0, 4, 8, 12};
+
 struct sm8250_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
 	struct snd_soc_card *card;
@@ -36,6 +49,9 @@ static int sm8250_snd_init(struct snd_soc_pcm_runtime *rtd)
 	switch (cpu_dai->id) {
 	case DISPLAY_PORT_RX:
 		return qcom_snd_dp_jack_setup(rtd, &data->dp_jack, 0);
+	case PRIMARY_TDM_RX_0:
+		/* Speaker amps only, no jack on this link. */
+		return 0;
 	case USB_RX:
 		return qcom_snd_usb_offload_jack_setup(rtd, &data->usb_offload_jack,
 						       &data->usb_offload_jack_setup);
@@ -63,8 +79,19 @@ static int sm8250_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	struct snd_interval *channels = hw_param_interval(params,
 					SNDRV_PCM_HW_PARAM_CHANNELS);
 	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 
 	rate->min = rate->max = 48000;
+	if (cpu_dai->id == PRIMARY_TDM_RX_0) {
+		/*
+		 * One channel per amp slot, 16-bit samples in 32-bit slots, as
+		 * stock (S16_LE here, cirrus,fixed-width = 32 on the amps).
+		 */
+		channels->min = channels->max = TDM_SLOTS;
+		snd_mask_none(fmt);
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+		return 0;
+	}
 	channels->min = channels->max = 2;
 	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
 
@@ -112,6 +139,22 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
 		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
 		break;
+	case PRIMARY_TDM_RX_0: {
+		struct snd_soc_dai *dai;
+		int i, ret;
+
+		snd_soc_dai_set_sysclk(cpu_dai,
+			Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT,
+			TDM_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+
+		codec_dai_fmt |= SND_SOC_DAIFMT_IB_NF | SND_SOC_DAIFMT_DSP_A;
+		for_each_rtd_codec_dais(rtd, i, dai) {
+			ret = snd_soc_dai_set_fmt(dai, codec_dai_fmt);
+			if (ret < 0)
+				return ret;
+		}
+		break;
+	}
 	default:
 		break;
 	}
@@ -119,6 +162,61 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 	return qcom_snd_sdw_startup(substream);
 }
 
+static int sm8250_snd_hw_params(struct snd_pcm_substream *substream,
+				struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai;
+	int i, ret;
+
+	if (cpu_dai->id != PRIMARY_TDM_RX_0)
+		return 0;
+
+	ret = snd_soc_dai_set_tdm_slot(cpu_dai, 0, GENMASK(TDM_SLOTS - 1, 0),
+				       TDM_SLOTS, TDM_SLOT_WIDTH);
+	if (ret < 0)
+		return ret;
+
+	ret = snd_soc_dai_set_channel_map(cpu_dai, 0, NULL,
+					  params_channels(params), tdm_slot_offset);
+	if (ret < 0)
+		return ret;
+
+	for_each_rtd_codec_dais(rtd, i, codec_dai) {
+		/* Amp i: RX1 = slot i, RX2 unused; VI feedback on TX1 = slot i. */
+		unsigned int rx_slot[2] = { i, TDM_UNUSED_SLOT };
+		unsigned int tx_slot[1] = { i };
+
+		if (i >= TDM_SLOTS)
+			return -EINVAL;
+
+		ret = snd_soc_dai_set_channel_map(codec_dai, 1, tx_slot, 2, rx_slot);
+		if (ret < 0)
+			return ret;
+
+		/* Without this the amp would size its slots from the 16-bit samples. */
+		ret = snd_soc_dai_set_tdm_slot(codec_dai, BIT(i), BIT(i),
+					       TDM_SLOTS, TDM_SLOT_WIDTH);
+		if (ret < 0)
+			return ret;
+
+		/* The amp's PLL runs from the TDM bit clock. */
+		ret = snd_soc_component_set_sysclk(codec_dai->component,
+						   CS35L41_CLKID_SCLK, 0,
+						   TDM_BCLK_RATE, SND_SOC_CLOCK_IN);
+		if (ret < 0)
+			return ret;
+
+		ret = snd_soc_dai_set_sysclk(codec_dai, 0, TDM_BCLK_RATE,
+					     SND_SOC_CLOCK_IN);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
 static int sm8250_snd_prepare(struct snd_pcm_substream *substream)
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
@@ -139,6 +237,7 @@ static int sm8250_snd_hw_free(struct snd_pcm_substream *substream)
 
 static const struct snd_soc_ops sm8250_be_ops = {
 	.startup = sm8250_snd_startup,
+	.hw_params = sm8250_snd_hw_params,
 	.shutdown = qcom_snd_sdw_shutdown,
 	.hw_free = sm8250_snd_hw_free,
 	.prepare = sm8250_snd_prepare,

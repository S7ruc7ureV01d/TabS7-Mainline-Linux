From: gts7l project
Subject: [PATCH] panel-novatek-nt36523: fix backlight control - drop
 broken get_brightness, use the panel's real 0-462 range, and update
 both DSI links

Three real bugs found and fixed together (all needed for backlight to
actually work on real hardware, confirmed live):

1. get_brightness() issued a real DCS 'get display brightness' read,
   which this panel's firmware never answers - confirmed live via
   sysfs actual_brightness returning an I/O error. KDE's powerdevil
   brightness helper reads actual_brightness before writing a new
   value and silently aborted the whole request when that read failed,
   with no error surfaced anywhere in userspace. Dropped the op
   entirely - standard mainline pattern for a write-only-brightness
   panel, backlight core falls back to the cached props.brightness.

2. max_brightness=4095/default=512 were arbitrary placeholders, not
   this panel's real range - downstream's own
   dsi_panel_NT36523_PPA957DB1_wqxga_video.dtsi declares
   qcom,mdss-dsi-bl-max-level = <462>. Values above 462 got
   silently clamped/ignored on real hardware.

3. The real blocker: this panel is dual-DSI
   (gts7l_desc.is_dual_dsi = true, like every other command in
   gts7l_init_sequence()), but update_status() only ever held dsi0
   (nt36523_create_backlight() only took a single mipi_dsi_device).
   The brightness command only ever reached one physical half of the
   panel. Fixed by passing panel_info through instead and sending the
   DCS brightness command to both dsi0 and dsi1, matching every other
   command in this driver. Confirmed fixed on real hardware
   (2026-09-22): brightness slider now visibly dims/brightens the
   screen.

--- a/drivers/gpu/drm/panel/panel-novatek-nt36523.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
@@ -1705,54 +1705,93 @@
 
 static int nt36523_bl_update_status(struct backlight_device *bl)
 {
-	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	/*
+	 * gts7l (the only panel this driver's has_dcs_backlight currently
+	 * covers) is dual-DSI (gts7l_desc.is_dual_dsi = true) - every other
+	 * command in this panel's whole init sequence
+	 * (mipi_dsi_dual_dcs_write_seq_multi throughout gts7l_init_sequence())
+	 * is deliberately sent to *both* DSI links, since each drives half
+	 * of the physical panel. This function used to only hold dsi0 (see
+	 * nt36523_create_backlight()'s old single-mipi_dsi_device argument)
+	 * and only ever sent the brightness command to that one half -
+	 * confirmed as the real cause of a real symptom on actual hardware
+	 * (writing any value, low or high, to sysfs `brightness` changed
+	 * the stored value but produced zero visible change on the
+	 * physical screen). Send to both links, matching every other
+	 * command in this driver.
+	 */
+	struct panel_info *pinfo = bl_get_data(bl);
 	u16 brightness = backlight_get_brightness(bl);
 	int ret;
 
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	pinfo->dsi[0]->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	if (pinfo->desc->is_dual_dsi)
+		pinfo->dsi[1]->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
-	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	ret = mipi_dsi_dcs_set_display_brightness_large(pinfo->dsi[0], brightness);
 	if (ret < 0)
 		return ret;
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-
-	return 0;
-}
-
-static int nt36523_bl_get_brightness(struct backlight_device *bl)
-{
-	struct mipi_dsi_device *dsi = bl_get_data(bl);
-	u16 brightness;
-	int ret;
-
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
-	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
-	if (ret < 0)
-		return ret;
+	if (pinfo->desc->is_dual_dsi) {
+		ret = mipi_dsi_dcs_set_display_brightness_large(pinfo->dsi[1], brightness);
+		if (ret < 0)
+			return ret;
+	}
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	pinfo->dsi[0]->mode_flags |= MIPI_DSI_MODE_LPM;
+	if (pinfo->desc->is_dual_dsi)
+		pinfo->dsi[1]->mode_flags |= MIPI_DSI_MODE_LPM;
 
-	return brightness;
+	return 0;
 }
 
+/*
+ * No .get_brightness op, deliberately: this panel's real hardware never
+ * answers the DCS "get display brightness" read command (confirmed on
+ * real hardware - the read reliably fails, surfacing as an I/O error on
+ * sysfs's `actual_brightness`), a real limitation of this command-mode
+ * LCD panel (see isl98608-gts7l.c's own comment - not AMOLED, as an
+ * earlier version of this comment guessed), not a driver bug. Leaving
+ * get_brightness unset is the standard mainline pattern for a
+ * write-only-brightness panel: the backlight core then reports
+ * `bl->props.brightness` (the last successfully-written value) instead
+ * of attempting a live read. Without this, anything that reads
+ * `actual_brightness` before writing a new value (confirmed: KDE's
+ * powerdevil brightness helper does exactly this) silently aborts the
+ * whole brightness-change request, with no error surfaced anywhere in
+ * userspace - real symptom, not guessed.
+ */
 static const struct backlight_ops nt36523_bl_ops = {
 	.update_status = nt36523_bl_update_status,
-	.get_brightness = nt36523_bl_get_brightness,
 };
 
-static struct backlight_device *nt36523_create_backlight(struct mipi_dsi_device *dsi)
+static struct backlight_device *nt36523_create_backlight(struct panel_info *pinfo)
 {
+	struct mipi_dsi_device *dsi = pinfo->dsi[0];
 	struct device *dev = &dsi->dev;
+	/*
+	 * 4095/512 were arbitrary placeholder values, not this panel's real
+	 * range - downstream's own dsi_panel_NT36523_PPA957DB1_wqxga_video.dtsi
+	 * declares `qcom,mdss-dsi-bl-max-level = <462>` and
+	 * `qcom,mdss-dsi-bl-min-level = <4>` (the actual DCS
+	 * SET_DISPLAY_BRIGHTNESS range this panel's firmware understands).
+	 * Sending raw values above 462 (like the placeholder's own default
+	 * of 512, or a UI slider naively scaled to 0-4095) is out of range
+	 * for the panel and got silently clamped/ignored on real hardware -
+	 * confirmed live: writing 100 or 4095 to sysfs `brightness` updated
+	 * the value but produced zero visible change on the physical
+	 * screen. This driver only has this one panel variant (no other
+	 * `compatible` entry shares nt36523_create_backlight()), so fixing
+	 * this default is safe.
+	 */
 	const struct backlight_properties props = {
 		.type = BACKLIGHT_RAW,
-		.brightness = 512,
-		.max_brightness = 4095,
+		.brightness = 231,
+		.max_brightness = 462,
 		.scale = BACKLIGHT_SCALE_NON_LINEAR,
 	};
 
-	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+	return devm_backlight_device_register(dev, dev_name(dev), dev, pinfo,
 					      &nt36523_bl_ops, &props);
 }
 
@@ -1817,7 +1856,7 @@
 	pinfo->panel.prepare_prev_first = true;
 
 	if (pinfo->desc->has_dcs_backlight) {
-		pinfo->panel.backlight = nt36523_create_backlight(dsi);
+		pinfo->panel.backlight = nt36523_create_backlight(pinfo);
 		if (IS_ERR(pinfo->panel.backlight))
 			return dev_err_probe(dev, PTR_ERR(pinfo->panel.backlight),
 					     "Failed to create backlight\n");

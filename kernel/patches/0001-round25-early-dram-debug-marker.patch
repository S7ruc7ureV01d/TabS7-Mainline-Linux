diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index 87a822e5c..dc4bb4c38 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -83,6 +83,29 @@
 	 *  x21        primary_entry() .. start_kernel()        FDT pointer passed at boot in x0
 	 */
 SYM_CODE_START(primary_entry)
+	/*
+	 * Round 25 debug marker (docs/kernel-boot-debugging.md,
+	 * UbuntuTabS7 project) - write a known, otherwise-impossible-by-
+	 * coincidence 64-bit pattern to a fixed physical address in this
+	 * device's known-free memory gap, before anything else runs. MMU is
+	 * guaranteed off here per the mandatory arm64 boot protocol
+	 * precondition, so this plain physical write is always safe
+	 * regardless of how we were entered. Explicit cache-clean + barrier
+	 * so the write reaches real DRAM (not just a cache line, which does
+	 * not survive a reset) before any later crash/hang/reset - the same
+	 * warm-reset DRAM-persistence principle pstore/ramoops already
+	 * relies on. Read back from TWRP after a hang to tell whether the
+	 * kernel's very first instructions ever actually executed.
+	 */
+	movz	x9, #0x9500, lsl #16
+	movz	x10, #0xc0de
+	movk	x10, #0xcafe, lsl #16
+	movk	x10, #0xbeef, lsl #32
+	movk	x10, #0xdead, lsl #48
+	str	x10, [x9]
+	dc	cvac, x9
+	dsb	sy
+
 	bl	record_mmu_state
 	bl	preserve_boot_args
 

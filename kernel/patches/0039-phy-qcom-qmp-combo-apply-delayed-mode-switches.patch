From: gts7l project
Subject: [PATCH] phy: qcom: qmp-combo: apply delayed mode switches, recover
 the USB PHY after DP-only

qmp_combo_typec_mux_set() refuses to leave DP mode while the DP PHY is
powered on ("DP PHY is still in use, delaying switch") and returns 0, but
nothing ever applies the switch later. After unplugging a DP-only (pin C)
monitor the PHY stayed in DP-only mode and USB was dead until reboot.

- Remember the refused mode and apply it from qmp_combo_dp_power_off().
  The switch body moves to qmp_combo_switch_mode().
- Right after leaving DP-only mode the USB PCS may not come up
  (PHYSTATUS stays set; seen for over 300 ms, fine a while later).
  Retry the USB power-on a few times; if it still fails, mark the USB
  PHY stale and redo the full re-init on the next orientation set, even
  with an unchanged orientation (a USB-C driver sets it on every attach).
- qmp_combo_usb_power_on()'s timeout path disabled the pipe clock, which
  since the move to com_init/com_exit is not its to disable: the next
  com_exit() then warned "gcc_usb3_prim_phy_pipe_clk already disabled".

Tested on SM8250 (gts7l): monitor unplug, then a PC cable: USB device
mode comes back (with the USB-C driver keeping dwc3 in host mode until
the next attach).

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index cdcfad2e8..542b82065 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -2305,6 +2305,11 @@ struct qmp_combo {
 	struct phy_configure_opts_dp dp_opts;
 	unsigned int dp_init_count;
 	bool dp_powered_on;
+	/* mode switch requested while the DP PHY was powered on */
+	bool mode_pending;
+	enum qmpphy_mode pending_mode;
+	/* the USB PHY failed to come back up after a switch */
+	bool usb_stale;
 
 	struct clk_fixed_rate pipe_clk_fixed;
 	struct clk_hw dp_link_hw;
@@ -3848,6 +3853,8 @@ static int qmp_combo_dp_power_on(struct phy *phy)
 	return 0;
 }
 
+static void qmp_combo_switch_mode(struct qmp_combo *qmp, enum qmpphy_mode new_mode);
+
 static int qmp_combo_dp_power_off(struct phy *phy)
 {
 	struct qmp_combo *qmp = phy_get_drvdata(phy);
@@ -3859,6 +3866,16 @@ static int qmp_combo_dp_power_off(struct phy *phy)
 
 	qmp->dp_powered_on = false;
 
+	/* Apply a mode switch that typec_mux_set had to delay */
+	if (qmp->mode_pending) {
+		qmp->mode_pending = false;
+		if (qmp->pending_mode != qmp->qmpphy_mode) {
+			dev_dbg(qmp->dev, "applying delayed switch to mode %d\n",
+				 qmp->pending_mode);
+			qmp_combo_switch_mode(qmp, qmp->pending_mode);
+		}
+	}
+
 	mutex_unlock(&qmp->phy_mutex);
 
 	return 0;
@@ -3910,15 +3927,11 @@ static int qmp_combo_usb_power_on(struct phy *phy)
 			PHY_INIT_COMPLETE_TIMEOUT);
 	if (ret) {
 		dev_err(qmp->dev, "phy initialization timed-out\n");
-		goto err_disable_pipe_clk;
+		/* The pipe clock belongs to com_init/com_exit */
+		return ret;
 	}
 
 	return 0;
-
-err_disable_pipe_clk:
-	clk_disable_unprepare(qmp->pipe_clk);
-
-	return ret;
 }
 
 static int qmp_combo_usb_power_off(struct phy *phy)
@@ -3940,6 +3953,29 @@ static int qmp_combo_usb_power_off(struct phy *phy)
 	return 0;
 }
 
+/*
+ * Power the USB PHY back on after a mode or orientation switch. dwc3
+ * holds the PIPE interface in reset for up to 100 ms while it changes
+ * role (GCTL.CoreSoftReset), and PHYSTATUS never clears meanwhile; a
+ * switch back from DP mode can land right in that window.
+ */
+static void qmp_combo_usb_power_on_retry(struct qmp_combo *qmp)
+{
+	int i;
+
+	for (i = 0; i < 5; i++) {
+		if (!qmp_combo_usb_power_on(qmp->usb_phy)) {
+			qmp->usb_stale = false;
+			return;
+		}
+		qmp_combo_usb_power_off(qmp->usb_phy);
+		msleep(50);
+	}
+	/* Seen right after leaving DP-only mode; it works a while later */
+	dev_warn(qmp->dev, "USB PHY did not come back up, retrying on next attach\n");
+	qmp->usb_stale = true;
+}
+
 static int qmp_combo_usb_init(struct phy *phy)
 {
 	struct qmp_combo *qmp = phy_get_drvdata(phy);
@@ -4429,7 +4465,8 @@ static int qmp_combo_typec_switch_set(struct typec_switch_dev *sw,
 	struct qmp_combo *qmp = typec_switch_get_drvdata(sw);
 	const struct qmp_phy_cfg *cfg = qmp->cfg;
 
-	if (orientation == qmp->orientation || orientation == TYPEC_ORIENTATION_NONE)
+	if (orientation == TYPEC_ORIENTATION_NONE ||
+	    (orientation == qmp->orientation && !qmp->usb_stale))
 		return 0;
 
 	mutex_lock(&qmp->phy_mutex);
@@ -4442,7 +4479,7 @@ static int qmp_combo_typec_switch_set(struct typec_switch_dev *sw,
 
 		qmp_combo_com_init(qmp, true);
 		if (qmp->usb_init_count)
-			qmp_combo_usb_power_on(qmp->usb_phy);
+			qmp_combo_usb_power_on_retry(qmp);
 		if (qmp->dp_init_count)
 			cfg->dp_aux_init(qmp);
 	}
@@ -4454,7 +4491,6 @@ static int qmp_combo_typec_switch_set(struct typec_switch_dev *sw,
 static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_state *state)
 {
 	struct qmp_combo *qmp = typec_mux_get_drvdata(mux);
-	const struct qmp_phy_cfg *cfg = qmp->cfg;
 	enum qmpphy_mode new_mode;
 	unsigned int svid;
 
@@ -4487,6 +4523,8 @@ static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_s
 		new_mode = QMPPHY_MODE_USB3_ONLY;
 	}
 
+	qmp->mode_pending = false;
+
 	if (new_mode == qmp->qmpphy_mode) {
 		dev_dbg(qmp->dev, "typec_mux_set: same qmpphy mode, bail out\n");
 		return 0;
@@ -4494,9 +4532,22 @@ static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_s
 
 	if (qmp->qmpphy_mode != QMPPHY_MODE_USB3_ONLY && qmp->dp_powered_on) {
 		dev_dbg(qmp->dev, "typec_mux_set: DP PHY is still in use, delaying switch\n");
+		qmp->pending_mode = new_mode;
+		qmp->mode_pending = true;
 		return 0;
 	}
 
+	qmp_combo_switch_mode(qmp, new_mode);
+
+	return 0;
+}
+
+static void qmp_combo_switch_mode(struct qmp_combo *qmp, enum qmpphy_mode new_mode)
+{
+	const struct qmp_phy_cfg *cfg = qmp->cfg;
+
+	lockdep_assert_held(&qmp->phy_mutex);
+
 	dev_dbg(qmp->dev, "typec_mux_set: switching from qmpphy mode %d to %d\n",
 		qmp->qmpphy_mode, new_mode);
 
@@ -4520,7 +4571,7 @@ static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_s
 		}
 
 		if (new_mode == QMPPHY_MODE_USB3DP || new_mode == QMPPHY_MODE_USB3_ONLY) {
-			qmp_combo_usb_power_on(qmp->usb_phy);
+			qmp_combo_usb_power_on_retry(qmp);
 			if (!qmp->usb_init_count)
 				qmp->usb_init_count++;
 		}
@@ -4530,8 +4581,6 @@ static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_s
 				cfg->dp_aux_init(qmp);
 		}
 	}
-
-	return 0;
 }
 
 static void qmp_combo_typec_switch_unregister(void *data)
